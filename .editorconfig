root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml,xml,props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = when_on_single_line:silent
csharp_style_expression_bodied_constructors = when_on_single_line:silent
csharp_style_expression_bodied_accessors = when_on_single_line:silent
csharp_style_prefer_primary_constructors = true:silent
csharp_style_prefer_switch_expression = true:suggestion

# CA1000: Static factory members on generic result types (ApiResponse<T>.Ok, CacheResult<T>.Hit)
# are an intentional, widely used idiom. Type inference is not required at these call sites.
dotnet_diagnostic.CA1000.severity = none

# CA1848/CA1873: Structured logging delegates are generated centrally where hot paths warrant it;
# the remaining calls use the standard ILogger extensions for readability.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

# CA1812: Types resolved by the DI container are not visible to the analyzer.
dotnet_diagnostic.CA1812.severity = suggestion
